{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MoonwalkCleanrooms",
      "Effect": "Allow",
      "Action": [
        "cleanrooms:ListCollaborations",
        "cleanrooms:ListConfiguredTables",
        "cleanrooms:ListMemberships"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkCleanroomsLimitedToKinds",
      "Effect": "Allow",
      "Action": [
        "cleanrooms:GetCollaboration",
        "cleanrooms:GetConfiguredTable",
        "cleanrooms:GetMembership",
        "cleanrooms:ListMembers"
      ],
      "Resource": [
        "arn:aws:cleanrooms:*:111122223333:collaboration/*",
        "arn:aws:cleanrooms:*:111122223333:configuredtable/*",
        "arn:aws:cleanrooms:*:111122223333:membership/*"
      ]
    },
    {
      "Sid": "MoonwalkCleanroomsLimitedToService",
      "Effect": "Allow",
      "Action": [
        "cleanrooms:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:cleanrooms:*:111122223333:*"
      ]
    },
    {
      "Sid": "MoonwalkCloudfront",
      "Effect": "Allow",
      "Action": [
        "cloudfront:ListDistributions",
        "cloudfront:ListKeyValueStores"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkCloudwatch",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:ListAccessGrants",
        "cloudwatch:ListDomains",
        "cloudwatch:ListSpaces",
        "cloudwatch:ListViews"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkCloudwatchLimitedToKinds",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:DescribeAlarms",
        "cloudwatch:GetAlarmMuteRule",
        "cloudwatch:GetDomain",
        "cloudwatch:GetSpace",
        "cloudwatch:GetView",
        "cloudwatch:ListAlarmMuteRules"
      ],
      "Resource": [
        "arn:aws:cloudwatch:*:111122223333:alarm-mute-rule:*",
        "arn:aws:cloudwatch:*:111122223333:alarm:*",
        "arn:aws:cloudwatch:*:111122223333:domain/*",
        "arn:aws:cloudwatch:*:111122223333:space/*",
        "arn:aws:cloudwatch:*:111122223333:view/*"
      ]
    },
    {
      "Sid": "MoonwalkCloudwatchLimitedToService",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:cloudwatch:*:111122223333:*",
        "arn:aws:cloudwatch::111122223333:*"
      ]
    },
    {
      "Sid": "MoonwalkCodebuild",
      "Effect": "Allow",
      "Action": [
        "codebuild:ListProjects"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkCodebuildLimitedToKinds",
      "Effect": "Allow",
      "Action": [
        "codebuild:BatchGetProjects"
      ],
      "Resource": [
        "arn:aws:codebuild:*:111122223333:project/*"
      ]
    },
    {
      "Sid": "MoonwalkCodepipeline",
      "Effect": "Allow",
      "Action": [
        "codepipeline:ListPipelines"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkCodepipelineLimitedToKinds",
      "Effect": "Allow",
      "Action": [
        "codepipeline:GetPipeline",
        "codepipeline:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:codepipeline:*:111122223333:*",
        "arn:aws:codepipeline:*:111122223333:actiontype:*",
        "arn:aws:codepipeline:*:111122223333:webhook:*"
      ]
    },
    {
      "Sid": "MoonwalkConfig",
      "Effect": "Allow",
      "Action": [
        "config:DescribeConfigRules"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkConfigLimitedToService",
      "Effect": "Allow",
      "Action": [
        "config:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:config:*:111122223333:*"
      ]
    },
    {
      "Sid": "MoonwalkDms",
      "Effect": "Allow",
      "Action": [
        "dms:ListDataProviders"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkDmsLimitedToKinds",
      "Effect": "Allow",
      "Action": [
        "dms:ListInstanceProfiles",
        "dms:ListMigrationProjects"
      ],
      "Resource": [
        "arn:aws:dms:*:111122223333:data-provider:*",
        "arn:aws:dms:*:111122223333:instance-profile:*",
        "arn:aws:dms:*:111122223333:migration-project:*"
      ]
    },
    {
      "Sid": "MoonwalkDmsLimitedToService",
      "Effect": "Allow",
      "Action": [
        "dms:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:dms:*:111122223333:*"
      ]
    },
    {
      "Sid": "MoonwalkDsql",
      "Effect": "Allow",
      "Action": [
        "dsql:ListClusters"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkDsqlLimitedToKinds",
      "Effect": "Allow",
      "Action": [
        "dsql:GetCluster",
        "dsql:GetClusterPolicy",
        "dsql:GetVpcEndpointServiceName",
        "dsql:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:dsql:*:111122223333:cluster/*",
        "arn:aws:dsql:*:111122223333:cluster/*/stream/*"
      ]
    },
    {
      "Sid": "MoonwalkDynamodb",
      "Effect": "Allow",
      "Action": [
        "dynamodb:ListTables"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkDynamodbLimitedToKinds",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:DescribeTable",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:ListTagsOfResource"
      ],
      "Resource": [
        "arn:aws:dynamodb:*:111122223333:table/*",
        "arn:aws:dynamodb:*:111122223333:table/*/stream/*"
      ]
    },
    {
      "Sid": "MoonwalkEc2",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAddresses",
        "ec2:DescribeFlowLogs",
        "ec2:DescribeImages",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeInstances",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeKeyPairs",
        "ec2:DescribeLaunchTemplateVersions",
        "ec2:DescribeLaunchTemplates",
        "ec2:DescribeNatGateways",
        "ec2:DescribeNetworkAcls",
        "ec2:DescribeNetworkInsightsAccessScopes",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribePrefixLists",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecondaryNetworks",
        "ec2:DescribeSecondarySubnets",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeTags",
        "ec2:DescribeTransitGatewayMeteringPolicies",
        "ec2:DescribeVolumes",
        "ec2:DescribeVpcEndpoints",
        "ec2:DescribeVpcs"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkEc2LimitedToKinds",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeImageAttribute",
        "ec2:DescribeVpcAttribute",
        "ec2:GetNetworkInsightsAccessScopeContent"
      ],
      "Resource": [
        "arn:aws:ec2:*:111122223333:network-insights-access-scope/*",
        "arn:aws:ec2:*:111122223333:vpc/*",
        "arn:aws:ec2:*::image/*"
      ]
    },
    {
      "Sid": "MoonwalkEcrLimitedToKinds",
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeRepositories",
        "ecr:GetLifecyclePolicy",
        "ecr:GetRepositoryPolicy",
        "ecr:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:ecr:*:111122223333:repository/*"
      ]
    },
    {
      "Sid": "MoonwalkEcs",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeTaskDefinition",
        "ecs:ListClusters",
        "ecs:ListDaemonTaskDefinitions",
        "ecs:ListTaskDefinitions"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkEcsLimitedToKinds",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeClusters",
        "ecs:DescribeDaemonTaskDefinition"
      ],
      "Resource": [
        "arn:aws:ecs:*:111122223333:cluster/*",
        "arn:aws:ecs:*:111122223333:daemon-task-definition/*"
      ]
    },
    {
      "Sid": "MoonwalkEks",
      "Effect": "Allow",
      "Action": [
        "eks:ListClusters"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkEksLimitedToKinds",
      "Effect": "Allow",
      "Action": [
        "eks:DescribeCluster"
      ],
      "Resource": [
        "arn:aws:eks:*:111122223333:cluster/*"
      ]
    },
    {
      "Sid": "MoonwalkElasticloadbalancing",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DescribeCapacityReservation",
        "elasticloadbalancing:DescribeLoadBalancerAttributes",
        "elasticloadbalancing:DescribeLoadBalancers",
        "elasticloadbalancing:DescribeTags",
        "elasticloadbalancing:DescribeTargetGroupAttributes",
        "elasticloadbalancing:DescribeTargetGroups"
      ],
      "Resource": [
        "*"
      ]
    }
  ]
}
