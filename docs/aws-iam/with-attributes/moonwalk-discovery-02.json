{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MoonwalkCodebuildLimited",
      "Effect": "Allow",
      "Action": [
        "codebuild:BatchGetProjects"
      ],
      "Resource": [
        "arn:aws:codebuild:*:111122223333:project/*"
      ]
    },
    {
      "Sid": "MoonwalkCodepipeline",
      "Effect": "Allow",
      "Action": [
        "codepipeline:ListPipelines"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkCodepipelineLimited",
      "Effect": "Allow",
      "Action": [
        "codepipeline:GetPipeline",
        "codepipeline:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:codepipeline:*:111122223333:*",
        "arn:aws:codepipeline:*:111122223333:actiontype:*",
        "arn:aws:codepipeline:*:111122223333:webhook:*"
      ]
    },
    {
      "Sid": "MoonwalkConfig",
      "Effect": "Allow",
      "Action": [
        "config:DescribeConfigRules"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkConfigLimited",
      "Effect": "Allow",
      "Action": [
        "config:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:config:*:111122223333:*"
      ]
    },
    {
      "Sid": "MoonwalkDms",
      "Effect": "Allow",
      "Action": [
        "dms:ListDataProviders"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkDmsLimited",
      "Effect": "Allow",
      "Action": [
        "dms:ListInstanceProfiles",
        "dms:ListMigrationProjects",
        "dms:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:dms:*:111122223333:*"
      ]
    },
    {
      "Sid": "MoonwalkDsql",
      "Effect": "Allow",
      "Action": [
        "dsql:ListClusters"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkDsqlLimited",
      "Effect": "Allow",
      "Action": [
        "dsql:GetCluster",
        "dsql:GetClusterPolicy",
        "dsql:GetVpcEndpointServiceName",
        "dsql:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:dsql:*:111122223333:cluster/*",
        "arn:aws:dsql:*:111122223333:cluster/*/stream/*"
      ]
    },
    {
      "Sid": "MoonwalkDynamodb",
      "Effect": "Allow",
      "Action": [
        "dynamodb:ListTables"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkDynamodbLimited",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:DescribeTable",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:ListTagsOfResource"
      ],
      "Resource": [
        "arn:aws:dynamodb:*:111122223333:table/*",
        "arn:aws:dynamodb:*:111122223333:table/*/stream/*"
      ]
    },
    {
      "Sid": "MoonwalkEc2",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAddresses",
        "ec2:DescribeFlowLogs",
        "ec2:DescribeImages",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeInstances",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeKeyPairs",
        "ec2:DescribeLaunchTemplateVersions",
        "ec2:DescribeLaunchTemplates",
        "ec2:DescribeNatGateways",
        "ec2:DescribeNetworkAcls",
        "ec2:DescribeNetworkInsightsAccessScopes",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribePrefixLists",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecondaryNetworks",
        "ec2:DescribeSecondarySubnets",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeTags",
        "ec2:DescribeTransitGatewayMeteringPolicies",
        "ec2:DescribeVolumes",
        "ec2:DescribeVpcEndpoints",
        "ec2:DescribeVpcs"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkEc2Limited",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeImageAttribute",
        "ec2:DescribeVpcAttribute",
        "ec2:GetNetworkInsightsAccessScopeContent"
      ],
      "Resource": [
        "arn:aws:ec2:*:111122223333:network-insights-access-scope/*",
        "arn:aws:ec2:*:111122223333:vpc/*",
        "arn:aws:ec2:*::image/*"
      ]
    },
    {
      "Sid": "MoonwalkEcrLimited",
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeRepositories",
        "ecr:GetLifecyclePolicy",
        "ecr:GetRepositoryPolicy",
        "ecr:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:ecr:*:111122223333:repository/*"
      ]
    },
    {
      "Sid": "MoonwalkEcs",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeTaskDefinition",
        "ecs:ListClusters",
        "ecs:ListDaemonTaskDefinitions",
        "ecs:ListTaskDefinitions"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkEcsLimited",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeClusters",
        "ecs:DescribeDaemonTaskDefinition"
      ],
      "Resource": [
        "arn:aws:ecs:*:111122223333:cluster/*",
        "arn:aws:ecs:*:111122223333:daemon-task-definition/*"
      ]
    },
    {
      "Sid": "MoonwalkEks",
      "Effect": "Allow",
      "Action": [
        "eks:ListClusters"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkEksLimited",
      "Effect": "Allow",
      "Action": [
        "eks:DescribeCluster"
      ],
      "Resource": [
        "arn:aws:eks:*:111122223333:cluster/*"
      ]
    },
    {
      "Sid": "MoonwalkElasticloadbalancing",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DescribeCapacityReservation",
        "elasticloadbalancing:DescribeLoadBalancerAttributes",
        "elasticloadbalancing:DescribeLoadBalancers",
        "elasticloadbalancing:DescribeTags",
        "elasticloadbalancing:DescribeTargetGroupAttributes",
        "elasticloadbalancing:DescribeTargetGroups"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkEvents",
      "Effect": "Allow",
      "Action": [
        "events:ListRules"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkEventsLimited",
      "Effect": "Allow",
      "Action": [
        "events:DescribeRule"
      ],
      "Resource": [
        "arn:aws:events:*:111122223333:rule/*"
      ]
    },
    {
      "Sid": "MoonwalkFirehose",
      "Effect": "Allow",
      "Action": [
        "firehose:ListDeliveryStreams"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkFirehoseLimited",
      "Effect": "Allow",
      "Action": [
        "firehose:DescribeDeliveryStream",
        "firehose:ListTagsForDeliveryStream"
      ],
      "Resource": [
        "arn:aws:firehose:*:111122223333:deliverystream/*"
      ]
    },
    {
      "Sid": "MoonwalkFisLimited",
      "Effect": "Allow",
      "Action": [
        "fis:GetSafetyLever"
      ],
      "Resource": [
        "arn:aws:fis:*:111122223333:safety-lever/*"
      ]
    },
    {
      "Sid": "MoonwalkGlue",
      "Effect": "Allow",
      "Action": [
        "glue:GetJobs"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkGlueLimited",
      "Effect": "Allow",
      "Action": [
        "glue:GetCatalogs",
        "glue:GetTags"
      ],
      "Resource": [
        "arn:aws:glue:*:111122223333:*"
      ]
    },
    {
      "Sid": "MoonwalkIam",
      "Effect": "Allow",
      "Action": [
        "iam:ListGroups",
        "iam:ListInstanceProfiles",
        "iam:ListOpenIDConnectProviders",
        "iam:ListPolicies",
        "iam:ListRoles",
        "iam:ListUsers"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkIamLimited",
      "Effect": "Allow",
      "Action": [
        "iam:GetInstanceProfile",
        "iam:GetOpenIDConnectProvider",
        "iam:GetPolicyVersion",
        "iam:ListAccessKeys",
        "iam:ListAttachedGroupPolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListAttachedUserPolicies",
        "iam:ListUserTags"
      ],
      "Resource": [
        "arn:aws:iam::111122223333:group/*",
        "arn:aws:iam::111122223333:instance-profile/*",
        "arn:aws:iam::111122223333:oidc-provider/*",
        "arn:aws:iam::111122223333:policy/*",
        "arn:aws:iam::111122223333:role/*",
        "arn:aws:iam::111122223333:user/*"
      ]
    },
    {
      "Sid": "MoonwalkKafka",
      "Effect": "Allow",
      "Action": [
        "kafka:GetBootstrapBrokers",
        "kafka:ListClusters",
        "kafka:ListClustersV2"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkKms",
      "Effect": "Allow",
      "Action": [
        "kms:ListAliases",
        "kms:ListKeys"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkKmsLimited",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:GetKeyPolicy",
        "kms:GetKeyRotationStatus",
        "kms:ListResourceTags"
      ],
      "Resource": [
        "arn:aws:kms:*:111122223333:key/*"
      ]
    }
  ]
}
