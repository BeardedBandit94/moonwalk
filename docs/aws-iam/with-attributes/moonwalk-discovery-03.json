{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MoonwalkLambda",
      "Effect": "Allow",
      "Action": [
        "lambda:ListCapacityProviders",
        "lambda:ListEventSourceMappings",
        "lambda:ListFunctions",
        "lambda:ListLayerVersions",
        "lambda:ListLayers",
        "lambda:ListMicrovmImages",
        "lambda:ListMicrovms",
        "lambda:ListNetworkConnectors",
        "lambda:ListWebFunctions"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkLambdaLimited",
      "Effect": "Allow",
      "Action": [
        "lambda:GetEventSourceMapping",
        "lambda:GetMicrovm",
        "lambda:GetMicrovmImage",
        "lambda:GetNetworkConnector",
        "lambda:GetResourcePolicy",
        "lambda:GetWebFunction",
        "lambda:ListFunctionVersionsByCapacityProvider",
        "lambda:ListTags"
      ],
      "Resource": [
        "arn:aws:lambda:*:111122223333:*"
      ]
    },
    {
      "Sid": "MoonwalkLogs",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkLogsLimited",
      "Effect": "Allow",
      "Action": [
        "logs:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:logs:*:111122223333:*"
      ]
    },
    {
      "Sid": "MoonwalkNetworkFirewall",
      "Effect": "Allow",
      "Action": [
        "network-firewall:ListContainerAssociations"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkNetworkFirewallLimited",
      "Effect": "Allow",
      "Action": [
        "network-firewall:DescribeContainerAssociation",
        "network-firewall:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:network-firewall:*:111122223333:*"
      ]
    },
    {
      "Sid": "MoonwalkNetworkSecurityManager",
      "Effect": "Allow",
      "Action": [
        "network-security-manager:GetAdminAccount",
        "network-security-manager:ListAdminAccounts",
        "network-security-manager:ListDeployments",
        "network-security-manager:ListPolicies",
        "network-security-manager:ListRules",
        "network-security-manager:ListScopes",
        "network-security-manager:ListTemplates"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkNetworkSecurityManagerLimited",
      "Effect": "Allow",
      "Action": [
        "network-security-manager:GetDeployment",
        "network-security-manager:GetPolicy",
        "network-security-manager:GetRule",
        "network-security-manager:GetScope",
        "network-security-manager:GetTemplate",
        "network-security-manager:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:network-security-manager:*:111122223333:deployment:*",
        "arn:aws:network-security-manager:*:111122223333:policy:*",
        "arn:aws:network-security-manager:*:111122223333:rule:*",
        "arn:aws:network-security-manager:*:111122223333:scope:*",
        "arn:aws:network-security-manager:*:111122223333:template:*"
      ]
    },
    {
      "Sid": "MoonwalkObservabilityadmin",
      "Effect": "Allow",
      "Action": [
        "observabilityadmin:ListTelemetryRules",
        "observabilityadmin:ListTelemetryRulesForOrganization"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkObservabilityadminLimited",
      "Effect": "Allow",
      "Action": [
        "observabilityadmin:GetTelemetryRule",
        "observabilityadmin:GetTelemetryRuleForOrganization",
        "observabilityadmin:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:observabilityadmin:*:111122223333:dataset-integration/*",
        "arn:aws:observabilityadmin:*:111122223333:organization-centralization-rule/*",
        "arn:aws:observabilityadmin:*:111122223333:organization-telemetry-rule/*",
        "arn:aws:observabilityadmin:*:111122223333:s3tableintegration/*",
        "arn:aws:observabilityadmin:*:111122223333:telemetry-pipeline/*",
        "arn:aws:observabilityadmin:*:111122223333:telemetry-rule/*"
      ]
    },
    {
      "Sid": "MoonwalkOrganizations",
      "Effect": "Allow",
      "Action": [
        "organizations:ListAWSServiceAccessForOrganization"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkOsis",
      "Effect": "Allow",
      "Action": [
        "osis:ListPipelineEndpoints",
        "osis:ListPipelines"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkOsisLimited",
      "Effect": "Allow",
      "Action": [
        "osis:GetPipeline",
        "osis:GetResourcePolicy"
      ],
      "Resource": [
        "arn:aws:osis:*:111122223333:pipeline/*"
      ]
    },
    {
      "Sid": "MoonwalkPricingplanmanager",
      "Effect": "Allow",
      "Action": [
        "pricingplanmanager:GetSubscription",
        "pricingplanmanager:ListSubscriptions"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkQuicksight",
      "Effect": "Allow",
      "Action": [
        "quicksight:DescribeAccountCustomPermission"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkRam",
      "Effect": "Allow",
      "Action": [
        "ram:GetResourceShareAssociations"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkRdsLimited",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBClusters",
        "rds:DescribeDBInstances",
        "rds:DescribeDBParameterGroups",
        "rds:DescribeDBParameters",
        "rds:DescribeDBSubnetGroups",
        "rds:DescribeTenantDatabases",
        "rds:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:rds:*:111122223333:*",
        "arn:aws:rds::111122223333:*"
      ]
    },
    {
      "Sid": "MoonwalkRekognition",
      "Effect": "Allow",
      "Action": [
        "rekognition:ListCollections"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkRekognitionLimited",
      "Effect": "Allow",
      "Action": [
        "rekognition:DescribeCollection",
        "rekognition:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:rekognition:*:111122223333:collection/*",
        "arn:aws:rekognition:*:111122223333:project/*",
        "arn:aws:rekognition:*:111122223333:project/*/dataset/*",
        "arn:aws:rekognition:*:111122223333:project/*/version/*",
        "arn:aws:rekognition:*:111122223333:streamprocessor/*"
      ]
    },
    {
      "Sid": "MoonwalkResiliencehub",
      "Effect": "Allow",
      "Action": [
        "resiliencehub:ListPolicies",
        "resiliencehub:ListServices",
        "resiliencehub:ListSystems"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkResiliencehubLimited",
      "Effect": "Allow",
      "Action": [
        "resiliencehub:GetPolicy",
        "resiliencehub:GetService",
        "resiliencehub:GetSystem"
      ],
      "Resource": [
        "arn:aws:resiliencehub:*:111122223333:policy/*",
        "arn:aws:resiliencehub:*:111122223333:service/*",
        "arn:aws:resiliencehub:*:111122223333:system/*"
      ]
    },
    {
      "Sid": "MoonwalkRoute53",
      "Effect": "Allow",
      "Action": [
        "route53:ListHostedZones"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkRoute53Limited",
      "Effect": "Allow",
      "Action": [
        "route53:GetHostedZone",
        "route53:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:route53:::healthcheck/*",
        "arn:aws:route53:::hostedzone/*"
      ]
    },
    {
      "Sid": "MoonwalkRoute53resolver",
      "Effect": "Allow",
      "Action": [
        "route53resolver:ListResolverRuleAssociations",
        "route53resolver:ListResolverRules"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "MoonwalkRoute53resolverLimited",
      "Effect": "Allow",
      "Action": [
        "route53resolver:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:route53resolver:*:111122223333:*"
      ]
    },
    {
      "Sid": "MoonwalkS3",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets",
        "s3:ListMultiRegionAccessPoints"
      ],
      "Resource": [
        "*"
      ]
    }
  ]
}
